{
  "expo": {
    "name": "EMDI Chantiers",
    "slug": "emdiapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "emdiapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B3D5C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emdi.chantiers"
    },
    "android": {
      "package": "com.emdi.chantiers",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D5C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accède à vos photos pour les partager sur les chantiers.",
          "cameraPermission": "L'application accède à la caméra pour prendre des photos de chantier."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "L'application accède au micro pour enregistrer des notes vocales."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
