rules_version = '2';

// Règles Firebase Storage — médias du chat, pièces de la GED, photos de rapport.
// Lecture/écriture réservées aux utilisateurs authentifiés. Taille limitée.
service firebase.storage {
  match /b/{bucket}/o {
    match /{dossier}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024; // 50 Mo max
    }
  }
}
