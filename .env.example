# Configuration des variables d'environnement — copier ce fichier en `.env`.
# Ces variables sont exposées côté client (EXPO_PUBLIC_*) : ne JAMAIS y mettre
# de secret serveur (ni la clé Supabase « service_role », ni de clé privée).

# ---------------------------------------------------------------------------
# SUPABASE (hébergement recommandé — voir GUIDE-SUPABASE.md)
# Project Settings → API. Si ces 2 variables sont renseignées, l'application
# utilise Supabase en priorité (sinon Firebase, sinon mode démo mémoire).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# FIREBASE (optionnel — utilisé pour les notifications push, et en secours
# comme base si Supabase n'est pas configuré). Console Firebase → Paramètres
# du projet → Général → Vos applications.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
