# Configuration Firebase — copier ce fichier en `.env` et renseigner les valeurs
# depuis la console Firebase (Paramètres du projet > Général > Vos applications).
# Ces variables sont exposées côté client : ne jamais y stocker de secret serveur.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
